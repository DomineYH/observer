{
  // Configs and tests (Vitest, Playwright, ESLint API).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["*.ts", "tests/**/*.ts", "terrain/**/*.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "exclude": ["tests/engines/main.ts"]
}
