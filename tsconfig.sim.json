{
  // The simulation alone: no DOM and no Node types, so screen and Node globals are type errors here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sim.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/sim/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
